# ============================================================
#  KotlinAZ — Apache / cPanel konfiqurasiyası
#
#  Bu faylı sayt kök qovluğuna (public_html) ".htaccess" adı ilə kopyala.
#  DİQQƏT: fayl adı nöqtə ilə başlayır — bəzi FTP proqramlarında gizli görünür.
# ============================================================

# ---------- Kodlaşdırma (Azərbaycan hərfləri üçün vacibdir) ----------
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js

# ---------- MIME tipləri ----------
<IfModule mod_mime.c>
    AddType text/html            .html
    AddType text/css             .css
    AddType application/javascript .js
    AddType image/svg+xml        .svg
    AddType font/woff2           .woff2
</IfModule>

# ---------- Başlanğıc fayl ----------
DirectoryIndex index.html

# ---------- Sıxılma ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- Keşləmə ----------
<IfModule mod_expires.c>
    ExpiresActive On

    # index.html keşlənmir ki, yeniləmələr dərhal görünsün
    ExpiresByType text/html "access plus 0 seconds"

    # CSS/JS-də ?v=... parametri var, ona görə uzun keş təhlükəsizdir
    ExpiresByType text/css             "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/svg+xml        "access plus 180 days"
    ExpiresByType image/png            "access plus 180 days"
    ExpiresByType font/woff2           "access plus 180 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Təhlükəsizlik başlıqları
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------- HTTPS-ə yönləndirmə ----------
# Sertifikat quraşdırıldıqdan SONRA aşağıdakı 3 sətri aktivləşdir:
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---------- Qovluq siyahısını bağla ----------
Options -Indexes

# ---------- Gizli faylları qoru ----------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
